# Copy this file to .env for running on your own computer.
# On Heroku these are set under Settings -> Config Vars instead.

# MySQL connection. On Heroku, the JawsDB add-on sets JAWSDB_URL for you automatically.
DATABASE_URL=mysql://chichi:chichi@localhost:3306/chichi

# A long random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The first administrator account, created automatically the first time the database is set up.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator
COMPANY_NAME=My Company

# Optional: how long a login lasts (default 12h)
JWT_EXPIRES_IN=12h
